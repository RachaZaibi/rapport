@startuml
start
:Receive vital signs data;
:Compare data with thresholds;

if (Anomaly detected?) then (yes)
  :Create alert in DB;
  :Set alert priority and status;
  :Send push notification (FCM);
else (no)
  :No alert generated;
endif

:Wait for confirmation;
if (Notification confirmed?) then (yes)
  :Update alert status to confirmed;
else (no)
  :Keep alert as active;
endif

stop
@enduml
