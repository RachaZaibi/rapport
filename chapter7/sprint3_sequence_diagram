@startuml
skinparam monochrome true
participant "DataProcessingSystem" as DPS
participant "AlertSystem" as AS
participant "Database" as DB
participant "NotificationSystem" as NS
participant "Dashboard" as DS
participant "MedicalStaff" as MS

DPS -> AS: Send processed data (data.id, HR=120)
AS -> DB: Retrieve alert rules (alert_rules.patient_id)
DB --> AS: Return rules (e.g., HR > 100)
AS -> AS: Check thresholds
alt Threshold violated
    AS -> DB: Create alert (alerts.patient_id, alerts.data_id)
    DB --> AS: Confirm alert stored
    AS -> NS: Trigger notification (alerts.id)
    NS -> MS: Send FCM notification (alert_medical_staff.medical_staff_id)
    MS -> DS: Apply filters (patient_id, priority)
    DS -> DB: Retrieve alerts and trends (data.type=HR)
    DB --> DS: Return data
    DS --> MS: Display alert and trends
    MS -> DS: Acknowledge alert
    DS -> DB: Update status (alert_medical_staff.status=resolved)
    DB --> DS: Confirm status updated
end alt

@enduml