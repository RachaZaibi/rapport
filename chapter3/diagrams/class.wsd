@startuml
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam packageStyle rectangle

' ===================== USERS =====================
class Utilisateur {
  +id : int
  +nom : string
  +prenom : string
  +email : string
  +motDePasse : string
  +role : string
  +personType : string
  +matricule : string
  +actif : boolean
  +fcmToken : string
  +login()
  +logout()
}

class Ticket {
  +id : int
  +titre : string
  +description : string
  +priorite : string
  +statut : string
  +dateCreation : date
  +dateResolution : date
  +assignerTechnicien()
  +cloturer()
}

class Intervention {
  +id : int
  +dateIntervention : date
  +typeIntervention : string
  +diagnostic : string
  +solution : string
  +dureeMinutes : int
  +piecesChangees : string
}

class Rapport {
  +id : int
  +titre : string
  +type : string
  +dateGeneration : date
  +format : string
  +payload : json
}

' ===================== EQUIPMENT =====================
class Equipement {
  +id : int
  +numeroSerie : string
  +inventoryNumber : string
  +codeQR : string
  +materialSource : string
  +currentStatus : string
  +assignedAt : date
  +marque : string
  +modele : string
  +dateAchat : date
  +etat : string
  +categorie : string
  +getHistorique()
  +genererQR()
}

class Maintenance {
  +id : int
  +maintenanceType : string
  +strategy : string
  +operationDate : date
  +details : string
  +cost : decimal
}

class Assignment {
  +id : int
  +assignmentType : string
  +assignedAt : date
  +signature : string
  +notes : string
  +active : boolean
}

class Transfer {
  +id : int
  +sourceType : string
  +destinationType : string
  +transferredAt : date
  +notes : string
}

' ===================== STRUCTURE =====================
class Bloc {
  +id : int
  +nom : string
  +code : string
  +description : string
}

class Departement {
  +id : int
  +nom : string
  +code : string
  +description : string
}

class Salle {
  +id : int
  +nom : string
  +type : string
  +etage : string
  +capacite : int
}

' ===================== SOFTWARE =====================
class Logiciel {
  +id : int
  +nom : string
  +version : string
  +editeur : string
  +typeLicence : string
  +nombrePostesAutorises : int
}

class Licence {
  +id : int
  +cleActivation : string
  +dateAchat : date
  +dateExpiration : date
  +nombrePostes : int
  +estExpiree()
}

class Installation {
  +id : int
  +dateInstallation : date
  +versionInstallee : string
  +statut : string
}

' ===================== RELATIONS =====================

' Users
Utilisateur "1" --> "*" Ticket : crée
Utilisateur "1" --> "*" Intervention : réalise
Utilisateur "1" --> "*" Rapport : génère
Utilisateur "1" --> "*" Equipement : est assigné à

' Ticket system
Ticket "1" --> "*" Intervention : génère
Equipement "1" --> "*" Ticket : concerne

' Equipment lifecycle
Equipement "1" --> "*" Maintenance
Equipement "1" --> "*" Assignment
Equipement "1" --> "*" Transfer
Equipement "1" --> "*" Installation

' Organization structure
Bloc "1" --> "*" Departement
Bloc "1" --> "*" Salle
Departement "1" --> "*" Salle
Departement "1" --> "*" Equipement
Salle "1" --> "*" Equipement

' Software
Logiciel "1" --> "*" Licence
Licence "1" --> "*" Installation

' Assignment relations
Assignment "*" --> "0..1" Utilisateur
Assignment "*" --> "0..1" Salle
Assignment "*" --> "0..1" Departement

' Transfer relations
Transfer "*" --> "0..1" Utilisateur
Transfer "*" --> "0..1" Salle
Transfer "*" --> "0..1" Departement

@enduml