@startuml
title Diagramme de déploiement

skinparam node {
    BackgroundColor #F0F8FF
    BorderColor #000080
}

skinparam component {
    BackgroundColor #E6E6FA
    BorderColor #4B0082
}

node "Couche de collecte des données" #FFDAB9 {
    node "Moniteurs médicaux" {
        artifact "Données vitales"
    }
    node "Caméras IP" {
        artifact "Flux vidéo"
    }
    "Moniteurs médicaux" -down-> "Caméras IP" : Capture des écrans
}

node "Couche de traitement et stockage" #87CEEB {
    node "Serveur Backend" {
        artifact "API Laravel"
    }
    node "Serveur Flask" {
        artifact "OpenCV"
        artifact "Tesseract OCR"
        artifact "YOLO"
    }
    database "Base de Données MySQL" #90EE90 {
        artifact "Données patient, mesures, alertes"
    }
    "Serveur Backend" -down-> "Base de Données MySQL" : Connexion SQL
}

node "Couche de visualisation et notification" #FFB6C1 {
    node "Appareils mobiles" {
        artifact "Application Flutter"
    }
    node "Application Web (React)" #DDA0DD {
        artifact "Interface utilisateur"
    }
    cloud "Firebase Cloud Messaging" #98FB98 {
        artifact "Service de notification"
    }
    "Appareils mobiles" -up-> "Firebase Cloud Messaging" : Réception des notifications
}

' Connexions
"Caméras IP" -[#blue]> "Serveur Flask" : Flux vidéo (Réseau sécurisé)
"Serveur Flask" -[#blue]> "Serveur Backend" : Données extraites (REST API)
"Serveur Backend" -[#green]> "Application Web (React)" : REST API / WebSockets
"Serveur Backend" -[#green]> "Appareils mobiles" : REST API / WebSockets
"Serveur Backend" -[#green]> "Firebase Cloud Messaging" : Alertes push

@enduml