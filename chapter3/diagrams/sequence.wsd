@startuml
skinparam monochrome true
actor "Camera" as Camera
participant "Machine (Mindray)" as Machine
participant "DataProcessingSystem" as DPS
participant "AlertSystem" as AS
participant "Patient" as Patient
participant "MedicalStaff" as MS
participant "NotificationSystem" as NS

Camera -> Machine: Capture video frame
Camera -> DPS: Send frame (cam_id, timestamp)
DPS -> DPS: Process frame with YOLOv8
DPS -> DPS: Extract vitals with OCR (e.g., HR=120)
DPS -> Patient: Store data (data.value, data.type=HR)
DPS -> Machine: Link data to machine (data.machine_id)
DPS -> AS: Send processed data (data.id)
AS -> Patient: Retrieve alert rules (alert_rules.patient_id)
AS -> AS: Check thresholds (e.g., HR > 100)
alt Threshold violated
    AS -> Patient: Create alert (alerts.patient_id, alerts.data_id)
    AS -> NS: Trigger notification (alerts.id)
    NS -> MS: Send FCM notification (alert_medical_staff.medical_staff_id)
    MS -> NS: Acknowledge alert (update alert_medical_staff.status=resolved)
end alt

@enduml