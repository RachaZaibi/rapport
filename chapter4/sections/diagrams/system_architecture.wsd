@startuml
title Architecture du Système

skinparam package {
    BackgroundColor #F0F8FF  
    BorderColor #000080     
}

skinparam component {
    BackgroundColor #E6E6FA  
    BorderColor #4B0082      
}

package "Serveur Local / Cloud" {
    component "Backend" as Backend #FFD700 
    component "Base de Données" as Database #87CEEB  
    component "Service de Notifications" as Notifications #90EE90  
    Backend --> Database : Stockage des données
    Backend --> Notifications : Envoi d’alertes
}

package "Appareils Médicaux" {
    component "Moniteur Mindray" as Monitor #FFA07A 
    component "Caméra OCR" as Camera #FFDAB9 
    Monitor --> Backend : API HL7
    Camera --> Backend : Données extraites
}

package "Applications Mobiles & Web" {
    component "Application Web" as WebApp #ADD8E6  
    component "Application Mobile" as MobileApp #FFB6C1 
    WebApp --> Backend : REST API
    MobileApp --> Backend : REST API
    Notifications --> MobileApp : Notifications Push
    Notifications --> WebApp : Notifications
}

@enduml