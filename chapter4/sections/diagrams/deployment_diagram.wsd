@startuml
title Diagramme de Déploiement

node "Serveur Local / Cloud" {
    component "Backend" as Backend
    component "Base de Données" as Database
    component "Service de Notifications" as Notifications
    Backend --> Database : Stockage des données
    Backend --> Notifications : Envoi des alertes
}

node "Appareils Médicaux" {
    component "Moniteur Mindray" as Monitor
    component "Caméra OCR" as Camera
    Monitor --> Backend : API / HL7
    Camera --> Backend : Données extraites (OCR)
}

node "Appareils Mobiles & Web" {
    component "Application Mobile" as MobileApp
    component "Application Web" as WebApp
    MobileApp --> Backend : REST API
    WebApp --> Backend : REST API
    Notifications --> MobileApp : Notifications Push
    Notifications --> WebApp : Alertes en temps réel
}

cloud "Cloud (Optionnel)" {
    component "Serveur Cloud" as CloudServer
    Backend --> CloudServer : Déploiement optionnel
}

note right of Monitor : Collecte des données en temps réel
note right of Camera : Capture et reconnaissance OCR
note right of Backend : Traitement des données et alertes
note right of Database : Stockage sécurisé des patients
note right of Notifications : Envoi d'alertes et de notifications
note right of MobileApp : Réception des notifications
note right of WebApp : Interface de visualisation

@enduml
